# Build the relay from the workspace; no FilmCraft GUI or GPU dependencies are included.
FROM rust:1.95-bookworm AS builder
WORKDIR /src
COPY . .
RUN cargo build --release -p filmcraft-relay

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 relay
COPY --from=builder /src/target/release/filmcraft-relay /usr/local/bin/filmcraft-relay
USER relay
EXPOSE 9001
ENTRYPOINT ["/usr/local/bin/filmcraft-relay"]
CMD ["0.0.0.0:9001"]
